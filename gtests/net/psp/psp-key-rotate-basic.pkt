// Test that PSP rx can receive packets with a SPI that is one rotation old.

--psp_udp_port=1000

// Initialize connection.
    0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
   +0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
   +0 bind(3, ..., ...) = 0
   +0 listen(3, 1) = 0

  +.1 < S 0:0(0) win 50000 <mss 1000,nop,wscale 0>
   +0 > S. 0:0(0) ack 1 <...>
  +.1 < . 1:1(0) ack 1 win 50000
   +0 accept(3, ..., ...) = 4

// Setup psp connection.
   +0 psp_rx_assoc(4, [7]) = 0
   +0 psp_tx_assoc(4, 23) = 0

// Receive before the rotation.
 +0.1 < encap psp spi 7 P. 1:501(500) ack 1 win 50000
+0~+0.1 > encap psp spi 23 . 1:1(0) ack 501
   +0 recv(4, ..., 1000, 0) = 500

// Rotate the device key without rekeying the socket.
   +0 psp_key_rotate() = 0

// Receive after the rotation: the association remains usable.
 +0.1 < encap psp spi 7 P. 501:1001(500) ack 1 win 50000
+0~+0.1 > encap psp spi 23 . 1:1(0) ack 1001
   +0 recv(4, ..., 1000, 0) = 500
